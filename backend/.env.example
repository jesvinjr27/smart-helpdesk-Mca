# Application Settings
PROJECT_NAME="AI-Based Smart Help Desk"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="smart-helpdesk-super-secure-dev-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# For local MySQL Community Edition:
# DATABASE_URL="mysql+pymysql://helpdesk_user:helpdesk_password@localhost:3306/smart_helpdesk?charset=utf8mb4"
# For SQLite (seamless local development / automated tests):
DATABASE_URL="sqlite:///./smart_helpdesk.db"

# AI / ML Service Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
AI_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
AI_FAISS_INDEX_DIR="./ai/artifacts"
AI_CLASSIFICATION_MODEL_PATH="./ai/artifacts/category_classifier.joblib"
AI_SLA_MODEL_PATH="./ai/artifacts/sla_risk_model.joblib"

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
