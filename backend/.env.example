# Application Settings
PROJECT_NAME="AI-Based Smart Help Desk"
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=smart-helpdesk-production-super-secret-key-2026-mca-project
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# For SQLite (default, seamless zero-config deployment):
DATABASE_URL=sqlite:///./smart_helpdesk.db
# For MySQL (if using external MySQL server):
# DATABASE_URL="mysql+pymysql://helpdesk_user:helpdesk_password@localhost:3306/smart_helpdesk?charset=utf8mb4"

# Embedded Machine Learning Models
AI_ML_MODEL_DIR="./backend/app/ai/ml/models"
AI_CLASSIFIER_PATH="./backend/app/ai/ml/models/category_classifier.joblib"
AI_SLA_MODEL_PATH="./backend/app/ai/ml/models/sla_risk_model.joblib"
AI_TRAINING_DATA_PATH="./backend/app/ai/ml/data/ticket_training_data.csv"

# Optional LLM Configuration
AI_LLM_ENABLED=false
AI_LLM_PROVIDER=disabled

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://*.vercel.app"]
